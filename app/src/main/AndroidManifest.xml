<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application
        android:allowBackup="true"
        android:label="Luncher Test"
        android:theme="@style/Theme.Luncher">
        <!-- On ENLEVE HOME pour tester comme une app normale -->
        <activity
            android:name="com.luncher.ui.LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.luncher.ui.SettingsActivity" android:exported="false" />
    </application>
</manifest>
