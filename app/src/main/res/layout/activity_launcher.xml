<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/time_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/heure_texte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="72sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-light"/>

        <TextView
            android:id="@+id/date_texte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lundi 1 Janvier"
            android:textSize="18sp"
            android:textColor="#E0FFFFFF"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/toggle_btn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_drawer"
        android:layout_marginBottom="16dp"
        android:tint="#FFFFFF"/>

    <LinearLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#E6000000"
        android:elevation="24dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="🔍 Rechercher une application..."
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:background="#20FFFFFF"
            android:paddingHorizontal="16dp"
            android:layout_margin="12dp"
            android:inputType="textFilter"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chargement..."
            android:textColor="#B0FFFFFF"
            android:gravity="center"
            android:padding="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apps_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permission_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FF000000"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 Permissions nécessaires"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pour afficher les messages au-dessus de toutes les applications :\n\n• ✅ Accès aux notifications\n• ✅ Afficher par-dessus les autres apps\n• ✅ Recevoir les SMS"
            android:textSize="15sp"
            android:textColor="#E0FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btn_grant_all"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="✅ Accorder toutes les permissions"
            android:textSize="16sp"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
