<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8FAFC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="#FFFFFF">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luncher" android:textSize="32sp" android:textStyle="bold" android:textColor="#0F172A" android:fontFamily="sans-serif"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#F5F3FF" app:strokeColor="#DDD6FE" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="16dp"><TextView android:text="⌕" android:textColor="#7C3AED"/><EditText android:id="@+id/searchBar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@null" android:hint="Rechercher une app..." android:layout_marginStart="8dp"/><TextView android:id="@+id/clearSearch" android:layout_width="32dp" android:layout_height="32dp" android:text="✕" android:gravity="center" android:visibility="gone"/></LinearLayout></com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerApps" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:clipToPadding="false"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="72dp" android:layout_margin="12dp" app:cardCornerRadius="28dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="8dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal">
            <LinearLayout android:id="@+id/btnPhone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:text="◉" android:textSize="20sp" android:textColor="#7C3AED"/><TextView android:text="Tél" android:textSize="10sp" android:textColor="#0F172A" android:textStyle="bold"/></LinearLayout>
            <LinearLayout android:id="@+id/btnSms" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:text="✉" android:textSize="20sp" android:textColor="#94A3B8"/><TextView android:text="SMS" android:textSize="10sp" android:textColor="#94A3B8"/></LinearLayout>
            <LinearLayout android:id="@+id/btnFiles" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:text="▭" android:textSize="20sp" android:textColor="#94A3B8"/><TextView android:text="Fichiers" android:textSize="10sp" android:textColor="#94A3B8"/></LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
