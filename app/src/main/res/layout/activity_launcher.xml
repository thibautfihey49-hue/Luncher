<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FOND D'ÉCRAN : image de fond -->
    <ImageView
        android:id="@+id/wallpaper_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- HEURE ET DATE -->
    <LinearLayout
        android:id="@+id/time_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp">

        <TextView
            android:id="@+id/heure_texte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="70sp"
            android:fontFamily="sans-serif-light"
            android:textColor="#FFFFFF"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"/>

        <TextView
            android:id="@+id/date_texte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="5dp"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"/>
    </LinearLayout>

    <!-- POIGNÉE D'OUVERTURE DU TIROIR -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="50dp"
        android:layout_height="5dp"
        android:background="#80FFFFFF"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TIROIR D'APPLICATIONS -->
    <LinearLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#00000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- BARRE DE RECHERCHE -->
        <EditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rechercher une application..."
            android:inputType="text"
            android:padding="15dp"
            android:layout_margin="10dp"
            android:background="#E0FFFFFF"
            android:textColor="#FF000000"
            android:hintTextColor="#FF666666"/>

        <!-- LISTE DES APPLICATIONS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apps_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="5dp"/>
    </LinearLayout>

    <!-- ÉCRAN DE DEMANDE DE PERMISSIONS -->
    <LinearLayout
        android:id="@+id/permission_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#DD000000"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions nécessaires"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accès aux notifications, fichiers et superposition"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="30dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btn_grant_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accorder toutes les permissions"
            android:background="#FF2196F3"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="30dp"
            android:paddingVertical="10dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
