<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:id="@+id/root_layout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/heure_texte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="80sp"
            android:textStyle="bold"
            android:textColor="#FF000000"/>

        <TextView
            android:id="@+id/date_texte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lundi 1 Janvier"
            android:textSize="20sp"
            android:textColor="#FF000000"
            android:layout_marginTop="8dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌 Appui long sur l'heure pour changer la couleur"
            android:textSize="12sp"
            android:textColor="#80000000"
            android:layout_marginTop="20dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:background="#80FFFFFF"
        android:elevation="0dp">

        <ImageView
            android:id="@+id/toggle_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_expand"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="#CCFFFFFF"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="🔍 Rechercher une application..."
            android:background="@drawable/search_bg"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:layout_margin="16dp"
            android:inputType="textPersonName"
            android:gravity="center_vertical"/>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apps_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

</LinearLayout>
