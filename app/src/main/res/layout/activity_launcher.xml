<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8FAFC" android:padding="12dp">
    <EditText android:id="@+id/searchBar" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Search apps..." android:background="#FFFFFF" android:padding="12dp" android:elevation="2dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerApps" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:background="#FFFFFF" android:elevation="4dp">
        <TextView android:id="@+id/btnPhone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Phone" android:gravity="center" android:textStyle="bold"/>
        <TextView android:id="@+id/btnSms" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="SMS" android:gravity="center" android:textStyle="bold"/>
        <TextView android:id="@+id/btnFiles" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Files" android:gravity="center" android:textStyle="bold"/>
    </LinearLayout>
    <View android:id="@+id/clearSearch" android:layout_width="0dp" android:layout_height="0dp"/>
</LinearLayout>