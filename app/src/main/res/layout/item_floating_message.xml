<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1AFFFFFF"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#2563EB"
            android:gravity="center"
            android:layout_marginEnd="12dp">
            
            <ImageView
                android:id="@+id/msg_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:tint="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/msg_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#60A5FA"/>

                <TextView
                    android:id="@+id/msg_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#80FFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/msg_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/msg_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textSize="16sp"
            android:textColor="#FF8080"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:id="@+id/msg_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#F0FFFFFF"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:layout_marginStart="52dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="52dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/msg_reply_btn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="✏️ Répondre"
            android:textSize="13sp"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/msg_open_app"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="📂 Ouvrir"
            android:textSize="13sp"
            android:backgroundTint="#1E40AF"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reply_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="52dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/msg_reply_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Votre réponse..."
            android:textSize="14sp"
            android:minHeight="45dp"
            android:background="#20FFFFFF"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:padding="10dp"/>

        <Button
            android:id="@+id/msg_send_reply"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="➤ Envoyer la réponse"
            android:textSize="14sp"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

</LinearLayout>
