<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="10dp"
    android:elevation="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="#FFFFFF30"
            android:gravity="center"
            android:layout_marginEnd="14dp">
            
            <ImageView
                android:id="@+id/notif_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:tint="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/notif_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#F0FFFFFF"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/notif_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"
                android:maxLines="6"
                android:scrollbars="vertical"
                android:ellipsize="none"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="✕ Fermer"
            android:textSize="13sp"
            android:backgroundTint="#FFFFFF30"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"
            android:elevation="0dp"/>

        <Button
            android:id="@+id/btn_open_app"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="📂 Ouvrir"
            android:textSize="13sp"
            android:backgroundTint="#FFFFFF30"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"
            android:elevation="0dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20FFFFFF"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_reply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Votre réponse..."
            android:textSize="14sp"
            android:minHeight="46dp"
            android:maxLines="3"
            android:background="#FFFFFF15"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textCursorDrawable="@null"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btn_send_reply"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="➤ Envoyer"
            android:textSize="13sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:layout_marginStart="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
