<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_margin="16dp"
    android:elevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="#1976D2"
            android:src="@android:drawable/ic_dialog_info"/>

        <TextView
            android:id="@+id/notif_app"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WhatsApp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17:00"
            android:textSize="11sp"
            android:textColor="#888888"/>

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#666666"
            android:padding="4dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/notif_sender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expéditeur"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/notif_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contenu du message..."
        android:textSize="13sp"
        android:textColor="#424242"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:ellipsize="end"/>

    <EditText
        android:id="@+id/et_reply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Réponse rapide..."
        android:inputType="textMultiLine"
        android:minLines="1"
        android:maxLines="3"
        android:background="#F5F5F5"
        android:padding="10dp"
        android:textSize="13sp"
        android:layout_marginTop="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_reply"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="✉️ Répondre"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="📂 Ouvrir"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
