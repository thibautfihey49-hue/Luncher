<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="8dp" android:background="@drawable/white_rounded_bg" android:elevation="16dp" android:padding="14dp">
    <TextView android:id="@+id/notifAppName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#FF000000" android:textSize="14sp" />
    <TextView android:id="@+id/notifTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF666666" android:textSize="12sp" />
    <TextView android:id="@+id/notifContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF222222" android:textSize="14sp" android:layout_marginTop="6dp" />
    <LinearLayout android:id="@+id/notifActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" />
</LinearLayout>
