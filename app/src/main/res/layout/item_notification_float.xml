<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="8dp" android:background="@drawable/white_rounded_bg" android:elevation="16dp" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/notifIcon" android:layout_width="32dp" android:layout_height="32dp" />
        <TextView android:id="@+id/notifAppName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textStyle="bold" android:textColor="#FF000000" android:textSize="14sp" />
        <TextView android:id="@+id/notifTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FF666666" />
    </LinearLayout>
    <TextView android:id="@+id/notifTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#FF000000" android:textSize="15sp" android:layout_marginTop="10dp" />
    <TextView android:id="@+id/notifContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF222222" android:textSize="14sp" android:layout_marginTop="4dp" android:maxLines="5" android:ellipsize="end" />
    <LinearLayout android:id="@+id/notifActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="end" />
</LinearLayout>

