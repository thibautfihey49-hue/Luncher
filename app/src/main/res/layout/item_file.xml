<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/fName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#000" android:singleLine="true"/>
        <TextView android:id="@+id/fInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#888"/>
    </LinearLayout>
    <TextView android:id="@+id/fCopy" android:layout_width="40dp" android:layout_height="32dp" android:text="⎘" android:gravity="center" android:background="#F0F0F0" android:layout_marginStart="4dp"/>
    <TextView android:id="@+id/fCut" android:layout_width="40dp" android:layout_height="32dp" android:text="✂️" android:gravity="center" android:background="#F0F0F0" android:layout_marginStart="4dp"/>
    <TextView android:id="@+id/fDel" android:layout_width="40dp" android:layout_height="32dp" android:text="🗑️" android:gravity="center" android:background="#FFEBEE" android:layout_marginStart="4dp"/>
</LinearLayout>
