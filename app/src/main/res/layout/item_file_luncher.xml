<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:background="#FFFFFF">
    <com.google.android.material.card.MaterialCardView android:layout_width="44dp" android:layout_height="44dp" app:cardCornerRadius="12dp" app:cardBackgroundColor="#FEF3C7"><TextView android:id="@+id/fIcon" android:layout_width="match_parent" android:layout_height="match_parent" android:text="📁" android:gravity="center" android:textSize="20sp"/></com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/fName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Android" android:textSize="15sp" android:textColor="#111827" android:fontFamily="sans-serif" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/fInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="10/08/2026 | 3 éléments" android:textSize="11sp" android:textColor="#6B7280" android:fontFamily="sans-serif" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="›" android:gravity="center" android:textSize="18sp" android:textColor="#9CA3AF"/>
</LinearLayout>
