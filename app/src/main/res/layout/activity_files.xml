<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8FAFC">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Files" android:textSize="36sp" android:textStyle="bold" android:fontFamily="serif" android:textColor="#0F172A"/>
            <EditText android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:hint="Search files, folders..." android:background="@drawable/bg_search" android:padding="16dp" android:elevation="2dp"/>
            <TextView android:id="@+id/tvPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="/storage/emulated/0" android:textSize="12sp" android:textColor="#7C3AED"/>
            <!-- CATEGORIES -->
            <LinearLayout android:id="@+id/layoutCategories" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2" android:layout_marginTop="16dp">
                    <LinearLayout android:id="@+id/cardDocuments" android:layout_width="0dp" android:layout_height="120dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass" android:elevation="2dp">
                        <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_glass_purple" android:gravity="center" android:text="=" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Documents" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/cardImages" android:layout_width="0dp" android:layout_height="120dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass" android:elevation="2dp">
                        <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_glass_purple" android:gravity="center" android:text="IMG"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Images" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/cardVideos" android:layout_width="0dp" android:layout_height="120dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass" android:elevation="2dp">
                        <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_glass_purple" android:gravity="center" android:text="▶"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Videos" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/cardAudio" android:layout_width="0dp" android:layout_height="120dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_glass" android:elevation="2dp">
                        <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_glass_purple" android:gravity="center" android:text="♫"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audio" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </GridLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stockage" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="20dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_glass" android:padding="16dp" android:layout_marginTop="8dp" android:elevation="2dp">
                    <TextView android:id="@+id/tvPercent" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_glass_purple" android:gravity="center" android:text="68%" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:id="@+id/tvUsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42.2 GB / 62 GB used" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvRemaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Remaining: 19.8 GB" android:textSize="12sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Healthy · Ready" android:background="@drawable/bg_glass_purple" android:padding="6dp" android:layout_marginTop="6dp" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!-- VRAIS FICHIERS -->
            <LinearLayout android:id="@+id/layoutFiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="44dp" android:text="← Retour" android:gravity="center" android:background="@drawable/bg_glass_purple" android:paddingHorizontal="16dp" android:elevation="2dp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerFiles" android:layout_width="match_parent" android:layout_height="600dp" android:layout_marginTop="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>