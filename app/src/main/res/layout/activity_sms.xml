<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F6F7F8">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#FFFFFF">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Messages" android:textSize="22sp" android:textColor="#111827" android:fontFamily="sans-serif" android:textStyle="bold"/>
        <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="⌕" android:gravity="center" android:textSize="20sp" android:background="#F3F4F6"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="8dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#E5E7EB"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="t" android:gravity="center"/></com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerConv" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:clipToPadding="false"/>
        <!-- CHAT -->
        <LinearLayout android:id="@+id/chatArea" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:background="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:padding="12dp" android:gravity="center_vertical"><TextView android:id="@+id/backChat" android:layout_width="40dp" android:layout_height="40dp" android:text="←" android:gravity="center" android:textSize="20sp" android:background="#F3F4F6"/><TextView android:id="@+id/chatTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Contact" android:textStyle="bold" android:textSize="16sp" android:layout_marginStart="12dp"/></LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerMsg" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp" android:background="#F6F7F8"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:background="#FFFFFF"><TextView android:id="@+id/btnImage" android:layout_width="44dp" android:layout_height="44dp" android:text="📷" android:gravity="center" android:background="#F3F4F6"/><EditText android:id="@+id/inputMsg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="Message" android:background="#F3F4F6" android:paddingHorizontal="16dp" android:layout_marginHorizontal="8dp"/><TextView android:id="@+id/btnVoice" android:layout_width="44dp" android:layout_height="44dp" android:text="🎤" android:gravity="center" android:background="#F3F4F6"/><TextView android:id="@+id/btnSend" android:layout_width="48dp" android:layout_height="48dp" android:text="↑" android:gravity="center" android:background="#111827" android:textColor="#FFFFFF"/></LinearLayout>
            <TextView android:id="@+id/voiceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔴 Enregistrement..." android:gravity="center" android:padding="12dp" android:background="#FEE2E2" android:visibility="gone"/>
        </LinearLayout>
        <!-- FAB -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/btnNew" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_gravity="bottom|end" android:layout_margin="16dp" app:cardCornerRadius="28dp" app:cardElevation="6dp" app:cardBackgroundColor="#111827"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:paddingHorizontal="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💬" android:textSize="18sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Démarrer une discussion" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium"/></LinearLayout></com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
