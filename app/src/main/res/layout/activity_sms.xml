<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8FAFC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="#FFFFFF"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Messages" android:textSize="30sp" android:textStyle="bold" android:textColor="#0F172A"/></LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerConv" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp"/>
    <LinearLayout android:id="@+id/chatArea" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone" android:background="#F8FAFC">
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="#FFFFFF"><TextView android:id="@+id/backChat" android:layout_width="48dp" android:layout_height="48dp" android:text="‹" android:gravity="center" android:textSize="24sp"/><TextView android:id="@+id/chatTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Chat" android:textStyle="bold"/><TextView android:layout_width="48dp" android:layout_height="48dp" android:text="⋮" android:gravity="center"/></LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerMsg" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical"><com.google.android.material.card.MaterialCardView android:layout_width="48dp" android:layout_height="48dp" app:cardCornerRadius="24dp" app:cardBackgroundColor="#FFFFFF"><TextView android:id="@+id/btnImage" android:layout_width="match_parent" android:layout_height="match_parent" android:text="◫" android:gravity="center" android:textSize="18sp"/></com.google.android.material.card.MaterialCardView><com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_marginHorizontal="8dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#FFFFFF" app:strokeColor="#E2E8F0" app:strokeWidth="1dp"><EditText android:id="@+id/inputMsg" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:hint="Message..." android:paddingHorizontal="16dp"/></com.google.android.material.card.MaterialCardView><com.google.android.material.card.MaterialCardView android:layout_width="48dp" android:layout_height="48dp" app:cardCornerRadius="24dp" app:cardBackgroundColor="#7C3AED"><TextView android:id="@+id/btnSend" android:layout_width="match_parent" android:layout_height="match_parent" android:text="↑" android:gravity="center" android:textColor="#FFFFFF"/></com.google.android.material.card.MaterialCardView><TextView android:id="@+id/btnVoice" android:layout_width="48dp" android:layout_height="48dp" android:text="◉" android:gravity="center" android:layout_marginStart="4dp"/><TextView android:id="@+id/voiceStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● REC" android:textColor="#FF0000" android:visibility="gone"/></LinearLayout>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="72dp" android:layout_margin="12dp" app:cardCornerRadius="28dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="8dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal"><LinearLayout android:id="@+id/btnNew" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><com.google.android.material.card.MaterialCardView android:layout_width="44dp" android:layout_height="44dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="#7C3AED"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="+" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp"/></com.google.android.material.card.MaterialCardView></LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
</LinearLayout>
