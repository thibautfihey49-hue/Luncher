<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#F8FAFC">
    <EditText android:id="@+id/smsNumber" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Numero" android:background="#FFF" android:padding="12dp"/>
    <EditText android:id="@+id/smsBody" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:hint="Message..." android:gravity="top" android:background="#FFF" android:padding="12dp" android:layout_marginTop="12dp"/>
    <Button android:id="@+id/btnSendSms" android:layout_width="match_parent" android:layout_height="56dp" android:text="Envoyer SMS" android:layout_marginTop="12dp" android:backgroundTint="#3B82F6"/>
</LinearLayout>