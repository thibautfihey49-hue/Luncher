<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F8F9">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#FFF">
        <TextView android:id="@+id/back" android:layout_width="40dp" android:layout_height="40dp" android:text="←" android:textSize="22sp" android:gravity="center" android:background="#F1F3F4"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Téléphone" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:layout_marginStart="12dp"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/btnDial" android:layout_width="wrap_content" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="#000"><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="⌨️ Clavier" android:textColor="#FFF" android:paddingHorizontal="16dp" android:gravity="center" android:textSize="13sp"/></com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp"/>
    <com.google.android.material.card.MaterialCardView android:id="@+id/dialPad" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:cardCornerRadius="28dp" app:cardElevation="8dp" android:layout_margin="12dp" app:cardBackgroundColor="#FFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <EditText android:id="@+id/inputNumber" android:layout_width="match_parent" android:layout_height="56dp" android:background="#F1F3F4" android:padding="16dp" android:textSize="22sp" android:hint="Numéro" android:textColor="#000" android:textColorHint="#9AA0A6"/>
            <GridLayout android:id="@+id/dialGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="4" android:layout_marginTop="16dp">
                <TextView android:text="1" style="@style/DialBtn"/><TextView android:text="2" style="@style/DialBtn"/><TextView android:text="3" style="@style/DialBtn"/>
                <TextView android:text="4" style="@style/DialBtn"/><TextView android:text="5" style="@style/DialBtn"/><TextView android:text="6" style="@style/DialBtn"/>
                <TextView android:text="7" style="@style/DialBtn"/><TextView android:text="8" style="@style/DialBtn"/><TextView android:text="9" style="@style/DialBtn"/>
                <TextView android:text="*" style="@style/DialBtn"/><TextView android:text="0" style="@style/DialBtn"/><TextView android:text="#" style="@style/DialBtn"/>
            </GridLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnCall" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" app:cardCornerRadius="28dp" app:cardBackgroundColor="#000"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="📞 Appeler" android:gravity="center" android:textColor="#FFF" android:textSize="16sp" android:textStyle="bold"/></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
