<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#F8FAFC">
    <EditText android:id="@+id/numberInput" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Numero" android:textSize="24sp" android:background="#FFF" android:padding="12dp"/>
    <GridLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:columnCount="3" android:rowCount="4" android:layout_marginTop="16dp">
        <TextView android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="1" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="2" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="3" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="4" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="5" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="6" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="7" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="8" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="9" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btnStar" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="*" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="0" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/btnHash" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:text="#" android:gravity="center" android:textSize="28sp" android:background="?attr/selectableItemBackground"/>
    </GridLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Effacer"/>
        <Button android:id="@+id/btnCall" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="2" android:text="Appeler" android:backgroundTint="#22C55E"/>
    </LinearLayout>
</LinearLayout>