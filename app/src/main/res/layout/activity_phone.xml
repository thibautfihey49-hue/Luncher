<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
        <TextView android:id="@+id/back" android:layout_width="40dp" android:layout_height="40dp" android:text="←" android:textSize="22sp" android:gravity="center" app:cardBackgroundColor="#F5F5F7"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Téléphone" android:textSize="22sp" android:textStyle="bold" android:layout_marginStart="12dp"/>
        <TextView android:id="@+id/btnDial" android:layout_width="wrap_content" android:layout_height="40dp" android:text="⌨️ Clavier" android:background="#000" android:textColor="#FFF" android:paddingHorizontal="16dp" android:gravity="center" android:textSize="13sp"/>
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="48dp" app:tabSelectedTextColor="#000" app:tabTextColor="#888"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:id="@+id/dialPad" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:background="#FAFAFA" android:padding="12dp">
        <EditText android:id="@+id/inputNumber" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Numéro" android:textSize="22sp" android:background="#FFF" android:padding="12dp"/>
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="4" android:layout_marginTop="12dp">
            <TextView android:text="1" style="@style/DialBtn"/><TextView android:text="2" style="@style/DialBtn"/><TextView android:text="3" style="@style/DialBtn"/>
            <TextView android:text="4" style="@style/DialBtn"/><TextView android:text="5" style="@style/DialBtn"/><TextView android:text="6" style="@style/DialBtn"/>
            <TextView android:text="7" style="@style/DialBtn"/><TextView android:text="8" style="@style/DialBtn"/><TextView android:text="9" style="@style/DialBtn"/>
            <TextView android:text="*" style="@style/DialBtn"/><TextView android:text="0" style="@style/DialBtn"/><TextView android:text="#" style="@style/DialBtn"/>
        </GridLayout>
        <TextView android:id="@+id/btnCall" android:layout_width="match_parent" android:layout_height="56dp" android:text="📞 Appeler" android:background="#000" android:textColor="#FFF" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
    </LinearLayout>
</LinearLayout>
