<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F6F7F8">
    <!-- Search pill -->
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="64dp" android:layout_margin="16dp" app:cardCornerRadius="32dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="☰" android:gravity="center" android:textSize="20sp"/>
            <EditText android:id="@+id/searchContact" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@null" android:hint="Rechercher dans les contacts" android:textSize="15sp" android:fontFamily="sans-serif" android:singleLine="true"/>
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:text="🎤" android:gravity="center" android:textSize="18sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Filters -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="12dp">
            <com.google.android.material.card.MaterialCardView android:id="@+id/chipTous" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_margin="4dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="#111827"><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="Tous" android:textColor="#FFFFFF" android:paddingHorizontal="20dp" android:gravity="center" android:textSize="14sp" android:fontFamily="sans-serif-medium"/></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="44dp" android:layout_margin="4dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="#E5E7EB"><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="Manqués" android:textColor="#111827" android:paddingHorizontal="20dp" android:gravity="center" android:textSize="14sp"/></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="44dp" android:layout_margin="4dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="#E5E7EB"><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="Contacts" android:textColor="#111827" android:paddingHorizontal="20dp" android:gravity="center" android:textSize="14sp"/></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="44dp" android:layout_margin="4dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="#E5E7EB"><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="Non-spam" android:textColor="#111827" android:paddingHorizontal="20dp" android:gravity="center" android:textSize="14sp"/></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Favoris header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginTop="8dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Favoris" android:textSize="20sp" android:textColor="#111827" android:textStyle="bold" android:fontFamily="sans-serif"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="#E5E7EB"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="+" android:gravity="center" android:textSize="20sp"/></com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aujourd'hui" android:textSize="22sp" android:textColor="#111827" android:textStyle="bold" android:fontFamily="sans-serif" android:paddingHorizontal="16dp" android:layout_marginTop="8dp"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp" android:clipToPadding="false"/>

    <!-- Clavier dialpad -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/dialPad" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:cardCornerRadius="28dp" app:cardElevation="12dp" android:layout_margin="12dp" app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <EditText android:id="@+id/inputNumber" android:layout_width="match_parent" android:layout_height="56dp" android:background="#F3F4F6" android:padding="16dp" android:textSize="22sp" android:hint="Numéro"/>
            <GridLayout android:id="@+id/dialGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="4" android:layout_marginTop="12dp">
                <TextView android:text="1" style="@style/DialBtn"/><TextView android:text="2" style="@style/DialBtn"/><TextView android:text="3" style="@style/DialBtn"/>
                <TextView android:text="4" style="@style/DialBtn"/><TextView android:text="5" style="@style/DialBtn"/><TextView android:text="6" style="@style/DialBtn"/>
                <TextView android:text="7" style="@style/DialBtn"/><TextView android:text="8" style="@style/DialBtn"/><TextView android:text="9" style="@style/DialBtn"/>
                <TextView android:text="*" style="@style/DialBtn"/><TextView android:text="0" style="@style/DialBtn"/><TextView android:text="#" style="@style/DialBtn"/>
            </GridLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnCall" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" app:cardCornerRadius="28dp" app:cardBackgroundColor="#111827"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="📞 Appeler" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom nav Luncher -->
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="72dp" android:layout_margin="12dp" app:cardCornerRadius="24dp" app:cardElevation="8dp" app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center">
            <LinearLayout android:id="@+id/back" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="20sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accueil" android:textSize="11sp" android:textColor="#111827" android:textStyle="bold"/></LinearLayout>
            <LinearLayout android:id="@+id/btnDial" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌨️" android:textSize="20sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clavier" android:textSize="11sp" android:textColor="#6B7280"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎙️" android:textSize="20sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Messagerie" android:textSize="11sp" android:textColor="#6B7280"/></LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
